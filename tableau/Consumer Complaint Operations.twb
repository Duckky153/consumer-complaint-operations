          <zone id="3" x="2000" y="5529" w="96000" h="5176" type="text">
            <formatted-text>
              <run fontname="Arial" fontsize="26" bold="true" fontcolor="#20364b">Which complaint patterns deserve a closer look?</run>
            </formatted-text>
          </zone>
          <zone id="4" x="2000" y="11647" w="96000" h="3176" type="text">
            <formatted-text>
              <run fontname="Arial" fontsize="14" bold="false" fontcolor="#20364b">2025 checking and savings complaints. Use public patterns to choose an internal validation question.</run>
            </formatted-text>
          </zone>
          <zone id="5" x="2000" y="16118" w="19167" h="7529" type="paramctrl" param="[Parameters].[Account type]" />
          <zone id="6" x="22833" y="16118" w="33750" h="7529" type="paramctrl" param="[Parameters].[Issue]" />
          <zone id="7" x="58250" y="16118" w="13333" h="7529" type="paramctrl" param="[Parameters].[Month]" />
          <zone id="8" x="73250" y="16118" w="24750" h="7529" type="paramctrl" param="[Parameters].[January sensitivity]" />
          <zone id="9" x="2000" y="23882" w="60833" h="7529" type="paramctrl" param="[Parameters].[Company]" />
          <zone id="10" x="64500" y="25412" w="33500" h="5294" type="text">
            <formatted-text>
              <run fontname="Arial" fontsize="12" bold="false" fontcolor="#20364b">Company narrows the view; volume does not rank performance.</run>
            </formatted-text>
          </zone>
          <zone id="11" x="2000" y="32941" w="18500" h="11059" name="Published complaints" show-title="true" />
          <zone id="12" x="21333" y="32941" w="18500" h="11059" name="Not timely" show-title="true" />
          <zone id="13" x="40667" y="32941" w="18500" h="11059" name="Not timely rate" show-title="true" />
          <zone id="14" x="60000" y="32941" w="18500" h="11059" name="Relief responses" show-title="true" />
          <zone id="15" x="79333" y="32941" w="18500" h="11059" name="Relief mix" show-title="true" />
          <zone id="16" x="2000" y="44941" w="96000" h="4941" name="Selection note" show-title="false" />
          <zone id="17" x="2000" y="52000" w="46583" h="31529" name="Monthly complaints" show-title="true" />
          <zone id="18" x="51083" y="52000" w="46917" h="31529" name="Monthly not-timely exceptions" show-title="true" />
          <zone id="19" x="2000" y="85765" w="96000" h="5765" type="text">
            <formatted-text>
              <run fontname="Arial" fontsize="14" bold="false" fontcolor="#20364b">Start with Managing an account, then compare the two January exclusions.
January’s original 18,367 complaints include 11,444 in two fixed company/issue clusters.</run>
            </formatted-text>
          </zone>
          <zone id="20" x="2000" y="92706" w="96000" h="2824" type="text">
            <formatted-text>
              <run fontname="Arial" fontsize="12" bold="false" fontcolor="#20364b">Public complaint volume is not a defect or harm rate. Relief is response mix, not proof of customer satisfaction.</run>
            </formatted-text>
          </zone>
          <zone id="21" x="2000" y="96118" w="96000" h="2353" type="text">
            <formatted-text>
              <run fontname="Arial" fontsize="11" bold="false" fontcolor="#5b6770">Source: CFPB · pinned snapshot extracted July 29, 2026 · all 84,194 observations retained in the data.</run>
            </formatted-text>
          </zone>
        </zone>
      </zones>
    </dashboard>
    <dashboard name="02 · Investigation">
      <layout-options />
      <style>
        <style-rule element="dashboard">
          <format attr="background-color" value="#f7f6f2" />
        </style-rule>
        <style-rule element="quick-filter">
          <format attr="font-size" value="12" />
        </style-rule>
      </style>
      <size maxheight="850" minheight="850" maxwidth="1200" minwidth="1200" />
      <datasources>
        <datasource name="complaints" />
        <datasource name="Parameters" />
      </datasources>
      <datasource-dependencies datasource="complaints">
        <column datatype="boolean" name="[Selected cohort]" caption="Selected cohort" role="dimension" type="nominal">
          <calculation class="tableau" formula="([Parameters].[Account type] = &quot;All account types&quot; OR [sub_product] = [Parameters].[Account type]) AND ([Parameters].[Issue] = &quot;All issues&quot; OR [issue] = [Parameters].[Issue]) AND ([Parameters].[Company] = &quot;All companies&quot; OR [company] = [Parameters].[Company]) AND ([Parameters].[Month] = &quot;All months&quot; OR [received_month] = [Parameters].[Month]) AND ([Parameters].[January sensitivity] = &quot;Baseline&quot; OR ([Parameters].[January sensitivity] = &quot;Exclude January&quot; AND [received_month] &lt;&gt; &quot;2025-01&quot;) OR ([Parameters].[January sensitivity] = &quot;Exclude January top two clusters&quot; AND [january_top_cluster] = 0))" />
        </column>
        <column-instance column="[Selected cohort]" derivation="None" name="[none:Selected cohort:nk]" pivot="key" type="nominal" />
      </datasource-dependencies>
      <datasource-dependencies datasource="Parameters">
        <column caption="Account type" datatype="string" name="[Account type]" param-domain-type="list" role="measure" type="nominal" value="&quot;All account types&quot;">
