            <column caption="Month" datatype="string" name="[Month]" param-domain-type="list" role="measure" type="nominal" value="&quot;All months&quot;">
              <calculation class="tableau" formula="&quot;All months&quot;" />
              <members>
                <member value="&quot;All months&quot;" />
                <member value="&quot;2025-01&quot;" />
                <member value="&quot;2025-02&quot;" />
                <member value="&quot;2025-03&quot;" />
