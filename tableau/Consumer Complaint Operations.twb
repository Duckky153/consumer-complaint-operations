        <style>
          <style-rule element="worksheet">
            <format attr="font-family" value="Arial" />
            <format attr="font-size" value="12" />
            <format attr="color" value="#20364b" />
          </style-rule>
          <style-rule element="axis">
            <format attr="font-family" value="Arial" />
            <format attr="font-size" value="12" />
            <format attr="color" value="#20364b" />
          </style-rule>
          <style-rule element="header">
            <format attr="font-family" value="Arial" />
            <format attr="font-size" value="12" />
            <format attr="color" value="#20364b" />
          </style-rule>
          <style-rule element="pane">
            <format attr="font-family" value="Arial" />
            <format attr="font-size" value="12" />
            <format attr="color" value="#20364b" />
          </style-rule>
        </style>
        <panes>
          <pane>
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[complaints].[usr:Relief mix:qk]" />
            </encodings>
            <customized-tooltip show-buttons="false">
              <formatted-text>
                <run>Complaints: &lt;[complaints].[usr:Selected complaints:qk]&gt;
Not timely: &lt;[complaints].[usr:Selected not timely:qk]&gt; (&lt;[complaints].[usr:Not timely rate:qk]&gt;)
Relief responses: &lt;[complaints].[usr:Selected relief:qk]&gt; (&lt;[complaints].[usr:Relief mix:qk]&gt;)</run>
              </formatted-text>
            </customized-tooltip>
            <customized-label>
              <formatted-text>
                <run fontname="Arial" fontsize="28" fontcolor="#20364b" bold="true">&lt;[complaints].[usr:Relief mix:qk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element="mark">
                <format attr="mark-color" value="#237d82" />
                <format attr="mark-labels-show" value="true" />
              </style-rule>
              <style-rule element="label">
                <format attr="font-size" value="28" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
    </worksheet>
    <worksheet name="Monthly complaints">
      <layout-options>
        <title>
          <formatted-text>
            <run fontname="Arial" fontsize="14" fontcolor="#20364b" bold="true">Monthly complaints</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource name="complaints" caption="Published CFPB complaints · 2025 snapshot" />
            <datasource name="Parameters" />
          </datasources>
          <datasource-dependencies datasource="complaints">
            <column datatype="integer" name="[Selected complaints]" caption="Selected complaints" role="measure" type="quantitative" default-format="n#,##0">
              <calculation class="tableau" formula="ZN(SUM(IF [Selected cohort] THEN [complaint_count] ELSE 0 END))" />
            </column>
            <column-instance column="[Selected complaints]" derivation="User" name="[usr:Selected complaints:qk]" pivot="key" type="quantitative" />
            <column datatype="boolean" name="[Selected cohort]" caption="Selected cohort" role="dimension" type="nominal">
              <calculation class="tableau" formula="([Parameters].[Account type] = &quot;All account types&quot; OR [sub_product] = [Parameters].[Account type]) AND ([Parameters].[Issue] = &quot;All issues&quot; OR [issue] = [Parameters].[Issue]) AND ([Parameters].[Company] = &quot;All companies&quot; OR [company] = [Parameters].[Company]) AND ([Parameters].[Month] = &quot;All months&quot; OR [received_month] = [Parameters].[Month]) AND ([Parameters].[January sensitivity] = &quot;Baseline&quot; OR ([Parameters].[January sensitivity] = &quot;Exclude January&quot; AND [received_month] &lt;&gt; &quot;2025-01&quot;) OR ([Parameters].[January sensitivity] = &quot;Exclude January top two clusters&quot; AND [january_top_cluster] = 0))" />
            </column>
            <column-instance column="[Selected cohort]" derivation="None" name="[none:Selected cohort:nk]" pivot="key" type="nominal" />
            <column datatype="integer" name="[Selected not timely]" caption="Selected not timely" role="measure" type="quantitative" default-format="n#,##0">
              <calculation class="tableau" formula="ZN(SUM(IF [Selected cohort] THEN [not_timely] ELSE 0 END))" />
            </column>
            <column-instance column="[Selected not timely]" derivation="User" name="[usr:Selected not timely:qk]" pivot="key" type="quantitative" />
            <column datatype="integer" name="[Selected relief]" caption="Selected relief" role="measure" type="quantitative" default-format="n#,##0">
              <calculation class="tableau" formula="ZN(SUM(IF [Selected cohort] THEN [has_relief] ELSE 0 END))" />
            </column>
            <column-instance column="[Selected relief]" derivation="User" name="[usr:Selected relief:qk]" pivot="key" type="quantitative" />
            <column datatype="real" name="[Not timely rate]" caption="Not timely rate" role="measure" type="quantitative" default-format="p0.00%">
              <calculation class="tableau" formula="IF [Selected complaints] &gt; 0 THEN [Selected not timely] / [Selected complaints] END" />
            </column>
            <column-instance column="[Not timely rate]" derivation="User" name="[usr:Not timely rate:qk]" pivot="key" type="quantitative" />
            <column datatype="real" name="[Relief mix]" caption="Relief mix" role="measure" type="quantitative" default-format="p0.00%">
              <calculation class="tableau" formula="IF [Selected complaints] &gt; 0 THEN [Selected relief] / [Selected complaints] END" />
            </column>
            <column-instance column="[Relief mix]" derivation="User" name="[usr:Relief mix:qk]" pivot="key" type="quantitative" />
            <column datatype="integer" name="[complaint_count]" caption="Complaint Count" role="measure" type="quantitative" default-format="n#,##0" />
            <column-instance column="[complaint_count]" derivation="Sum" name="[sum:complaint_count:qk]" pivot="key" type="quantitative" />
            <column datatype="integer" name="[not_timely]" caption="Not Timely" role="measure" type="quantitative" default-format="n#,##0" />
            <column-instance column="[not_timely]" derivation="Sum" name="[sum:not_timely:qk]" pivot="key" type="quantitative" />
            <column datatype="integer" name="[has_relief]" caption="Has Relief" role="measure" type="quantitative" default-format="n#,##0" />
            <column-instance column="[has_relief]" derivation="Sum" name="[sum:has_relief:qk]" pivot="key" type="quantitative" />
            <column datatype="string" name="[received_month]" caption="Month" role="dimension" type="nominal" />
            <column-instance column="[received_month]" derivation="None" name="[none:received_month:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <datasource-dependencies datasource="Parameters">
            <column caption="Account type" datatype="string" name="[Account type]" param-domain-type="list" role="measure" type="nominal" value="&quot;All account types&quot;">
              <calculation class="tableau" formula="&quot;All account types&quot;" />
              <members>
                <member value="&quot;All account types&quot;" />
                <member value="&quot;CD (Certificate of Deposit)&quot;" />
                <member value="&quot;Checking account&quot;" />
                <member value="&quot;Other banking product or service&quot;" />
                <member value="&quot;Savings account&quot;" />
              </members>
            </column>
            <column caption="Issue" datatype="string" name="[Issue]" param-domain-type="list" role="measure" type="nominal" value="&quot;All issues&quot;">
              <calculation class="tableau" formula="&quot;All issues&quot;" />
              <members>
                <member value="&quot;All issues&quot;" />
                <member value="&quot;Closing an account&quot;" />
                <member value="&quot;Credit monitoring or identity theft protection services&quot;" />
                <member value="&quot;Improper use of your report&quot;" />
                <member value="&quot;Incorrect information on your report&quot;" />
                <member value="&quot;Managing an account&quot;" />
