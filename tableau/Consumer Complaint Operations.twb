        </members>
      </column>
      <column caption="January sensitivity" datatype="string" name="[January sensitivity]" param-domain-type="list" role="measure" type="nominal" value="&quot;Baseline&quot;">
        <calculation class="tableau" formula="&quot;Baseline&quot;" />
        <members>
          <member value="&quot;Baseline&quot;" />
          <member value="&quot;Exclude January&quot;" />
          <member value="&quot;Exclude January top two clusters&quot;" />
        </members>
      </column>
    </datasource>
    <datasource caption="Published CFPB complaints · 2025 snapshot" inline="true" name="complaints" version="18.1">
      <connection class="federated">
        <named-connections>
          <named-connection name="hyper.complaints" caption="Complaint observations">
            <connection class="hyper" dbname="../data/processed/tableau-complaints.hyper" authentication="auth-none" author-locale="en_US" default-settings="yes" sslmode="" username="tableau_internal_user" />
          </named-connection>
        </named-connections>
        <relation connection="hyper.complaints" name="Extract" table="[Extract].[Extract]" type="table" />
      </connection>
      <column datatype="date" name="[date_received]" caption="Date Received" role="dimension" type="nominal" />
      <column datatype="string" name="[received_month]" caption="Month" role="dimension" type="nominal" />
      <column datatype="string" name="[sub_product]" caption="Sub Product" role="dimension" type="nominal" />
      <column datatype="string" name="[issue]" caption="Issue" role="dimension" type="nominal" />
      <column datatype="string" name="[sub_issue]" caption="Sub-issue" role="dimension" type="nominal" />
      <column datatype="string" name="[company]" caption="Company" role="dimension" type="nominal" />
      <column datatype="integer" name="[complaint_count]" caption="Complaint Count" role="measure" type="quantitative" default-format="n#,##0" />
      <column datatype="integer" name="[not_timely]" caption="Not Timely" role="measure" type="quantitative" default-format="n#,##0" />
      <column datatype="integer" name="[has_relief]" caption="Has Relief" role="measure" type="quantitative" default-format="n#,##0" />
      <column datatype="integer" name="[january_top_cluster]" caption="January Top Cluster" role="measure" type="quantitative" default-format="n#,##0" />
      <column datatype="boolean" name="[Selected cohort]" caption="Selected cohort" role="dimension" type="nominal">
        <calculation class="tableau" formula="([Parameters].[Account type] = &quot;All account types&quot; OR [sub_product] = [Parameters].[Account type]) AND ([Parameters].[Issue] = &quot;All issues&quot; OR [issue] = [Parameters].[Issue]) AND ([Parameters].[Company] = &quot;All companies&quot; OR [company] = [Parameters].[Company]) AND ([Parameters].[Month] = &quot;All months&quot; OR [received_month] = [Parameters].[Month]) AND ([Parameters].[January sensitivity] = &quot;Baseline&quot; OR ([Parameters].[January sensitivity] = &quot;Exclude January&quot; AND [received_month] &lt;&gt; &quot;2025-01&quot;) OR ([Parameters].[January sensitivity] = &quot;Exclude January top two clusters&quot; AND [january_top_cluster] = 0))" />
      </column>
      <column datatype="integer" name="[Selected complaints]" caption="Selected complaints" role="measure" type="quantitative" default-format="n#,##0">
        <calculation class="tableau" formula="ZN(SUM(IF [Selected cohort] THEN [complaint_count] ELSE 0 END))" />
      </column>
      <column datatype="integer" name="[Selected not timely]" caption="Selected not timely" role="measure" type="quantitative" default-format="n#,##0">
        <calculation class="tableau" formula="ZN(SUM(IF [Selected cohort] THEN [not_timely] ELSE 0 END))" />
      </column>
      <column datatype="integer" name="[Selected relief]" caption="Selected relief" role="measure" type="quantitative" default-format="n#,##0">
        <calculation class="tableau" formula="ZN(SUM(IF [Selected cohort] THEN [has_relief] ELSE 0 END))" />
      </column>
      <column datatype="real" name="[Not timely rate]" caption="Not timely rate" role="measure" type="quantitative" default-format="p0.00%">
        <calculation class="tableau" formula="IF [Selected complaints] &gt; 0 THEN [Selected not timely] / [Selected complaints] END" />
      </column>
      <column datatype="real" name="[Relief mix]" caption="Relief mix" role="measure" type="quantitative" default-format="p0.00%">
        <calculation class="tableau" formula="IF [Selected complaints] &gt; 0 THEN [Selected relief] / [Selected complaints] END" />
      </column>
      <column datatype="string" name="[Cohort note]" caption="Cohort note" role="measure" type="nominal">
        <calculation class="tableau" formula="IF [Selected complaints] = 0 THEN &quot;No complaints match. Change a control or Reset view. Rates are undefined.&quot; ELSEIF [Selected complaints] &lt; 30 THEN &quot;Small base: fewer than 30 complaints. Review individual cases; interpret percentages cautiously.&quot; ELSE &quot;Selected complaints are the denominator. Validate patterns against internal cases and transaction volumes.&quot; END" />
      </column>
      <column datatype="string" name="[Small group]" caption="Small group" role="measure" type="nominal">
        <calculation class="tableau" formula="IF SUM([complaint_count]) &lt; 30 THEN &quot; *&quot; ELSE &quot;&quot; END" />
      </column>
      <column datatype="string" name="[Reset label]" caption="Reset label" role="dimension" type="nominal">
        <calculation class="tableau" formula="&quot;Reset view&quot;" />
      </column>
      <column datatype="string" name="[Clear reset selection]" caption="Clear reset selection" role="dimension" type="nominal">
        <calculation class="tableau" formula="&quot;Clear selection&quot;" />
      </column>
      <column datatype="string" name="[Reset Account type]" caption="Reset Account type" role="dimension" type="nominal">
        <calculation class="tableau" formula="&quot;All account types&quot;" />
      </column>
      <column datatype="string" name="[Reset Issue]" caption="Reset Issue" role="dimension" type="nominal">
        <calculation class="tableau" formula="&quot;All issues&quot;" />
      </column>
      <column datatype="string" name="[Reset Company]" caption="Reset Company" role="dimension" type="nominal">
        <calculation class="tableau" formula="&quot;All companies&quot;" />
      </column>
      <column datatype="string" name="[Reset Month]" caption="Reset Month" role="dimension" type="nominal">
        <calculation class="tableau" formula="&quot;All months&quot;" />
      </column>
      <column datatype="string" name="[Reset January sensitivity]" caption="Reset January sensitivity" role="dimension" type="nominal">
        <calculation class="tableau" formula="&quot;Baseline&quot;" />
      </column>
    </datasource>
  </datasources>
  <actions>
    <action caption="Clear reset selection" name="[Clear 01]">
      <activation auto-clear="true" type="on-select" />
      <source dashboard="01 · Overview" type="sheet" worksheet="Reset view" />
      <link caption="Clear selection" delimiter="," escape="\" expression="tsl:Reset%20view?%5Bcomplaints%5D.%5BReset%20label%5D~s0=&lt;[Clear reset selection]~na&gt;" include-null="true" multi-select="true" url-escape="true" />
      <command command="tsc:tsl-filter">
        <param name="on-empty" value="all" />
        <param name="target" value="Reset view" />
      </command>
    </action>
    <action caption="Clear reset selection" name="[Clear 02]">
      <activation auto-clear="true" type="on-select" />
      <source dashboard="02 · Investigation" type="sheet" worksheet="Reset view" />
      <link caption="Clear selection" delimiter="," escape="\" expression="tsl:Reset%20view?%5Bcomplaints%5D.%5BReset%20label%5D~s0=&lt;[Clear reset selection]~na&gt;" include-null="true" multi-select="true" url-escape="true" />
      <command command="tsc:tsl-filter">
        <param name="on-empty" value="all" />
        <param name="target" value="Reset view" />
      </command>
    </action>
    <datasources>
      <datasource name="complaints" />
    </datasources>
    <datasource-dependencies datasource="complaints">
      <column datatype="string" name="[Reset label]" caption="Reset label" role="dimension" type="nominal">
        <calculation class="tableau" formula="&quot;Reset view&quot;" />
      </column>
      <column datatype="string" name="[Clear reset selection]" caption="Clear reset selection" role="dimension" type="nominal">
        <calculation class="tableau" formula="&quot;Clear selection&quot;" />
      </column>
    </datasource-dependencies>
