            </column>
            <column-instance column="[Reset Company]" derivation="None" name="[none:Reset Company:nk]" pivot="key" type="nominal" />
            <column datatype="string" name="[Reset Month]" caption="Reset Month" role="dimension" type="nominal">
              <calculation class="tableau" formula="&quot;All months&quot;" />
            </column>
            <column-instance column="[Reset Month]" derivation="None" name="[none:Reset Month:nk]" pivot="key" type="nominal" />
            <column datatype="string" name="[Reset January sensitivity]" caption="Reset January sensitivity" role="dimension" type="nominal">
              <calculation class="tableau" formula="&quot;Baseline&quot;" />
            </column>
            <column-instance column="[Reset January sensitivity]" derivation="None" name="[none:Reset January sensitivity:nk]" pivot="key" type="nominal" />
