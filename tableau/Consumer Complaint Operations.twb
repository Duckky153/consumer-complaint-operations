                <member value="&quot;Problem with fraud alerts or security freezes&quot;" />
                <member value="&quot;Unable to get your credit report or credit score&quot;" />
              </members>
            </column>
            <column caption="Company" datatype="string" name="[Company]" param-domain-type="list" role="measure" type="nominal" value="&quot;All companies&quot;">
              <calculation class="tableau" formula="&quot;All companies&quot;" />
              <members>
